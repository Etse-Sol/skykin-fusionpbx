# SMS Provider Integration (Africa's Talking)
# Use 'sandbox' as the username to test locally without a production account.
# Note: In sandbox mode, the API endpoint automatically points to the sandbox server.
SMS_API_USERNAME=sandbox
SMS_API_KEY=
SMS_SENDER_ID=

# FreeSWITCH Event Socket (ESL) — required for real-time agent status changes
# On the production VM (where PHP runs alongside FreeSWITCH), leave as 127.0.0.1:8021.
# FreeSWITCH's ESL ACL allows 127.0.0.1 by default (event_socket.conf.xml).
#
# For LOCAL DEVELOPMENT from Windows/Mac:
#   Option A – SSH tunnel:  ssh -L 8021:127.0.0.1:8021 user@<vm-ip>
#              Then set:    ESL_HOST=127.0.0.1
#   Option B – Allow your IP in /etc/freeswitch/autoload_configs/event_socket.conf.xml
#              and set:     ESL_HOST=<vm-ip>
#
# The ESL password is in /etc/freeswitch/autoload_configs/event_socket.conf.xml
# (look for <param name="password" value="..."/>). Default is ClueCon.
ESL_HOST=127.0.0.1
ESL_PORT=8021
ESL_PASSWORD=ClueCon
