# Copy to .env (docker compose reads this automatically)
WEB_PORT=8080
DB_PUBLISH_PORT=5433
DB_NAME=fusionpbx
DB_USER=fusionpbx
DB_PASSWORD=change-me-strong

# FreeSWITCH ESL (shared by web + freeswitch containers)
ESL_PASSWORD=ClueCon
ESL_HOST=freeswitch
ESL_PORT=8021
ESL_PUBLISH_PORT=8021

# Softphone WS (web nginx /wss/ proxies here)
FREESWITCH_WS_UPSTREAM=freeswitch:5066
FS_WS_PORT=5066
SIP_PORT=5060
# Carrier / external Sofia profile (Ethio trunk)
SIP_EXTERNAL_PORT=5080

# Lab RTP window mapped through Docker (includes odd RTCP ports = RTP+1).
# For production SIP trunks on Linux, prefer host networking (see docker/README.md)
# and a full range such as 16384-32768.
RTP_START_PORT=16384
RTP_END_PORT=16584
RTCP_AUDIO_INTERVAL_MSEC=5000

# SDP advertised address for the interconnect (example: 10.0.0.93).
# Leave blank to keep FreeSWITCH stun/auto defaults.
# EXT_RTP_IP=10.0.0.93
# EXT_SIP_IP=10.0.0.93

# Ethio IMS trunk (must match FusionPBX v_gateways). Without these,
# Sofia only has vanilla example.com and agent→mobile never originates.
TRUNK_GATEWAY_NAME=SIP
TRUNK_PROXY=10.208.233.134
TRUNK_REALM=ims.ethiotelecom.com
TRUNK_USERNAME=+251111138755
TRUNK_FROM_USER=+251111138755
TRUNK_FROM_DOMAIN=ims.ethiotelecom.com
TRUNK_REGISTER=false
TRUNK_TRANSPORT=udp
TRUNK_CODEC_PREFS=PCMA,PCMU

# --- Hybrid mode only (with docker-compose.hybrid.yml) ---
# ESL_HOST=host.docker.internal
# FREESWITCH_WS_UPSTREAM=host.docker.internal:5066
