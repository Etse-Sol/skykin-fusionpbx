# Copy to .env (docker compose reads this automatically)
WEB_PORT=8080
DB_PUBLISH_PORT=5433
DB_NAME=fusionpbx
DB_USER=fusionpbx
DB_PASSWORD=change-me-strong

# FreeSWITCH ESL (shared by web + freeswitch containers)
ESL_PASSWORD=ClueCon
ESL_HOST=freeswitch
ESL_PORT=8021
ESL_PUBLISH_PORT=8021

# Softphone WS. nginx /wss/ proxies to FreeSWITCH's WSS (secure) listener so
# SIP.js's WSS transport gets its REGISTER responses (else agents never register).
FREESWITCH_WS_UPSTREAM=freeswitch:7443
FREESWITCH_WS_SCHEME=https
# ecs-cc production uses the host WS-SIP helper (UDP registrations):
# FREESWITCH_WS_UPSTREAM=10.0.0.77:18081
# FREESWITCH_WS_SCHEME=http
FS_WS_PORT=5066
SIP_PORT=5060

# SIP domain must match agent dashboard "Domain" (and FusionPBX domain name).
FS_DOMAIN=client1.skykin.local
# Dashboard SIP/telephony domain. Set when the web host is a bare IP so agents
# register as ext@SKYKIN_DOMAIN (the domain the extensions live in), not @IP.
SKYKIN_DOMAIN=client1.skykin.local
# Public IP advertised in WebRTC SDP/ICE. Ethio b-leg uses FS_LAN_RTP_IP instead.
# EXTERNAL_SIP_IP=196.189.236.140
# EXTERNAL_RTP_IP=196.189.236.140

# FreeSWITCH directory users for WebRTC softphones (ext:password comma-separated).
# Keep in sync with FusionPBX Extensions passwords.
FS_DIRECTORY_USERS=100:11112222,101:1234567890,102:0987654321,103:22223333

# Call center queue (mod_callcenter) — drives agent Ready/Break and queue stats.
# Agents are "name:ext" where name = FusionPBX call_center_agent_uuid so the
# dashboard's "agent set status <uuid>" matches. Lab default may use just "ext".
FS_QUEUE_EXT=8000
FS_QUEUE_STRATEGY=longest-idle-agent
FS_QUEUE_AGENTS=101,102

# Ethio Telecom IMS trunk. register=true with the full IMS identity.
# Signaling whitelist of FS_LAN_RTP_IP is not enough — they must also add that
# same LAN IP as a media/RTP source (not the public NAT IP). One IMS REGISTER
# only: do not run this gateway on two FreeSWITCH hosts at once.
# FS_OUTBOUND_GATEWAY=SIP
# FS_OUTBOUND_PROXY=10.208.233.134
# FS_OUTBOUND_USERNAME=+251111138755
# FS_OUTBOUND_PASSWORD=changeme
# FS_OUTBOUND_CID=+251111138755
# FS_OUTBOUND_REGISTER=true
# FS_OUTBOUND_REALM=ims.ethiotelecom.com
# FS_OUTBOUND_AUTH_USERNAME=+251111138755@ims.ethiotelecom.com
# FS_OUTBOUND_FROM_DOMAIN=ims.ethiotelecom.com
# FS_OUTBOUND_REGISTER_PROXY=10.208.233.134
# FS_LAN_RTP_IP=10.0.0.77
# Same REGISTER; extra DID to try first is 756 (755 + 756). Widen to [5-9] later for 55–59.
# FS_INBOUND_DID_REGEX=^\\+?(?:251)?0?11113875[56]$

# Call detail records. The dashboards read "calls today", call history and the
# recordings list from the FusionPBX database, so mod_xml_cdr must post to the
# importer. CDR_CRED must match the cdr credentials FusionPBX expects, and the
# default setting cdr/http_enabled must be true.
CDR_URL=http://web/app/xml_cdr/xml_cdr_import.php
CDR_CRED=fusionpbx:fusionpbx

# HTTPS (required for microphone/WebRTC). Self-signed cert is generated on first
# start; point a DNS name at the server and swap in a real cert for production.
WEB_HTTPS_PORT=8443
TLS_CN=skykin.local
# TLS_SAN_IP=203.0.113.10   # add the public IP so the cert matches an IP URL

# Lab RTP window mapped through Docker (16384-16584).
# ecs-cc NAT currently forwards 16384-65000 UDP to 10.0.0.77; keep FreeSWITCH
# at 16584 unless you rebuild, so advertised ports stay inside the map.
# Production SIP trunks: host networking (docker-compose.ecs-cc.yml).
RTP_START_PORT=16384
RTP_END_PORT=16584

# --- Hybrid mode only (with docker-compose.hybrid.yml) ---
# ESL_HOST=host.docker.internal
# FREESWITCH_WS_UPSTREAM=host.docker.internal:5066
