# Copy to .env (docker compose reads this automatically)
WEB_PORT=8080
DB_PUBLISH_PORT=5433
DB_NAME=fusionpbx
DB_USER=fusionpbx
DB_PASSWORD=change-me-strong

# FreeSWITCH ESL (shared by web + freeswitch containers)
ESL_PASSWORD=ClueCon
ESL_HOST=freeswitch
ESL_PORT=8021
ESL_PUBLISH_PORT=8021

# Softphone WS (web nginx /wss/ proxies here)
FREESWITCH_WS_UPSTREAM=freeswitch:5066
FS_WS_PORT=5066
SIP_PORT=5060

# Lab RTP window mapped through Docker.
# For production SIP trunks on Linux, prefer host networking (see docker/README.md)
# and a full range such as 16384-32768.
RTP_START_PORT=16384
RTP_END_PORT=16584

# --- Hybrid mode only (with docker-compose.hybrid.yml) ---
# ESL_HOST=host.docker.internal
# FREESWITCH_WS_UPSTREAM=host.docker.internal:5066
