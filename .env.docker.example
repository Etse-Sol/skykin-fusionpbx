# Copy to .env (docker compose reads this automatically)
WEB_PORT=8080
WEB_HTTPS_PORT=8088
TLS_CN=196.189.236.140
TLS_SAN_IP=196.189.236.140
SKYKIN_DOMAIN=client1.skykin.local
CDR_CRED=fusionpbx:fusionpbx
DB_PUBLISH_PORT=5433
DB_NAME=fusionpbx
DB_USER=fusionpbx
DB_PASSWORD=change-me-strong

# FreeSWITCH ESL (shared by web + freeswitch containers)
ESL_PASSWORD=ClueCon
ESL_HOST=freeswitch
ESL_PORT=8021
ESL_PUBLISH_PORT=8021

# Softphone: nginx /wss/ → FreeSWITCH WSS (SIP.js transport=WSS needs 7443)
FREESWITCH_WS_UPSTREAM=freeswitch:7443
FREESWITCH_WS_SCHEME=https
FS_WS_PORT=5066
SIP_PORT=5060
# Carrier / external Sofia profile (Ethio trunk)
SIP_EXTERNAL_PORT=5080

# Lab RTP window mapped through Docker (includes odd RTCP ports = RTP+1).
# For production SIP trunks on Linux, prefer host networking (see docker/README.md)
# and a full range such as 16384-32768.
RTP_START_PORT=16384
RTP_END_PORT=16584
RTCP_AUDIO_INTERVAL_MSEC=5000

# SDP advertised address for the Ethio interconnect. Must be the private
# interconnect IP, not the public 196.189.236.140 — IMS ignores INVITEs
# whose Contact/source is the public address ([calling][0] / NO_ANSWER).
EXT_RTP_IP=10.0.0.93
EXT_SIP_IP=10.0.0.93

# Ethio IMS trunk (must match FusionPBX v_gateways). Without these,
# Sofia only has vanilla example.com and agent→mobile never originates.
TRUNK_GATEWAY_NAME=SIP
TRUNK_PROXY=10.208.233.134:5080
TRUNK_REALM=ims.ethiotelecom.com
TRUNK_USERNAME=+251111138755
TRUNK_FROM_USER=+251111138755
TRUNK_FROM_DOMAIN=ims.ethiotelecom.com
TRUNK_PASSWORD=
TRUNK_REGISTER=false
TRUNK_TRANSPORT=udp
TRUNK_CODEC_PREFS=PCMA,PCMU
TRUNK2_GATEWAY_NAME=SIP759
TRUNK2_USERNAME=+251111138759
TRUNK2_PASSWORD=
TRUNK2_FROM_USER=+251111138759
TRUNK2_FROM_DOMAIN=ims.ethiotelecom.com
TRUNK2_REALM=ims.ethiotelecom.com
TRUNK2_PROXY=10.208.233.134:5080
TRUNK2_REGISTER=true

# --- Host-network FreeSWITCH (docker-compose.fs-hostnet.yml) ---
# extra_hosts maps freeswitch → host-gateway (not 10.0.0.93).
# FREESWITCH_WS_UPSTREAM=freeswitch:7443
# FREESWITCH_WS_SCHEME=https
