# Copy to .env and adjust if needed (docker compose reads this automatically)
WEB_PORT=8080
DB_PUBLISH_PORT=5433
DB_NAME=fusionpbx
DB_USER=fusionpbx
DB_PASSWORD=fusionpbx

# FreeSWITCH on your VM / host (not inside Docker)
# Windows Docker Desktop: host.docker.internal works
# Linux: often host.docker.internal via compose extra_hosts, or use the VM IP
ESL_HOST=host.docker.internal
ESL_PORT=8021
ESL_PASSWORD=ClueCon
FREESWITCH_WS_UPSTREAM=host.docker.internal:5066
