# SMS Provider Integration (Africa's Talking)
SMS_API_USERNAME=sandbox
SMS_API_KEY=
SMS_SENDER_ID=

# FreeSWITCH Event Socket (ESL)
# Host: VM IP running FreeSWITCH
ESL_HOST=127.0.0.1
ESL_PORT=8021
# Password: copy from VM at /etc/freeswitch/autoload_configs/event_socket.conf.xml
# Run on VM:  grep -i password /etc/freeswitch/autoload_configs/event_socket.conf.xml
ESL_PASSWORD=ClueCon

# Local Development Auto-Login
DEV_AUTO_LOGIN=true
