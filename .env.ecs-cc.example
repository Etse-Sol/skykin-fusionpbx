# ecs-cc production backup. Copy to /opt/skykin/app/.env
# Fill FS_OUTBOUND_PASSWORD from FusionPBX v_gateways (not this file).
# Dashboard: https://196.189.236.140:8188  (HTTPS only)

WEB_PORT=8190
WEB_HTTPS_PORT=8188
DB_PUBLISH_PORT=5433
DB_NAME=fusionpbx
DB_USER=fusionpbx
DB_PASSWORD=changeme
ESL_PASSWORD=changeme
ESL_HOST=10.0.0.77
ESL_PORT=8021
ESL_PUBLISH_PORT=8021

# WS-SIP helper on the host (systemd skykin-ws-sip). Recreating skykin-web
# without this upstream drops /wss/ back to FreeSWITCH 7443 and agents fail.
FREESWITCH_WS_UPSTREAM=10.0.0.77:18081
FREESWITCH_WS_SCHEME=http

FS_DOMAIN=client1.skykin.local
SKYKIN_DOMAIN=client1.skykin.local
EXTERNAL_SIP_IP=196.189.236.140
EXTERNAL_RTP_IP=196.189.236.140
FS_LAN_RTP_IP=10.0.0.77
TLS_CN=196.189.236.140
TLS_SAN_IP=196.189.236.140,10.0.0.77

FS_DIRECTORY_USERS=
FS_QUEUE_EXT=8000
FS_QUEUE_STRATEGY=longest-idle-agent
FS_QUEUE_AGENTS=

# Ethio IMS. One REGISTER only — disable live SIP.xml on 10.0.0.93 first.
# Carrier must whitelist 10.0.0.77 for SIP and for media/RTP (not the WAN IP).
FS_OUTBOUND_GATEWAY=SIP
FS_OUTBOUND_PROXY=10.208.233.134
FS_OUTBOUND_USERNAME=+251111138755
FS_OUTBOUND_PASSWORD=changeme
FS_OUTBOUND_CID=+251111138755
FS_OUTBOUND_REGISTER=true
FS_OUTBOUND_REALM=ims.ethiotelecom.com
FS_OUTBOUND_AUTH_USERNAME=+251111138755@ims.ethiotelecom.com
FS_OUTBOUND_FROM_DOMAIN=ims.ethiotelecom.com
FS_OUTBOUND_REGISTER_PROXY=10.208.233.134
FS_INBOUND_DID_REGEX=^\\+?(?:251)?0?11113875[59]$

CDR_URL=http://127.0.0.1:8190/app/xml_cdr/xml_cdr_import.php
CDR_CRED=fusionpbx:fusionpbx

# NAT currently maps 16384-65000 UDP to 10.0.0.77. Keep FS at 16584 unless
# you rebuild; advertised ports must stay inside the forwarded window.
RTP_START_PORT=16384
RTP_END_PORT=16584
