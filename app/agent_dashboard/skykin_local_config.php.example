<?php
/**
 * Example local overrides — copy to skykin_local_config.php on the server.
 * Do NOT commit skykin_local_config.php (machine-specific).
 *
 * On the current local VM (optional recorder on :8001):
 *   cp skykin_local_config.php.example skykin_local_config.php
 *
 * On cloud: leave recordings_api_base / socket_io_url empty unless you
 * deploy that helper service, and set ahununu_url if needed.
 */
$host = preg_replace('/:\d+$/', '', $_SERVER['HTTP_HOST'] ?? 'localhost');

return [
	// Uncomment on the local VM only if the :8001 helper is running:
	// 'recordings_api_base' => 'http://' . $host . ':8001',
	// 'socket_io_url'       => 'http://' . $host . ':8001',

	'ahununu_url'    => 'https://ahununu.com/',
	'seed_demo_data' => false,
];
